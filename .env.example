# Booking emails (used by pages/api/send-booking.ts)
# Gmail account that sends the booking request emails. Use an app password, not the account password.
GMAIL_USER=
GMAIL_PASS=

# Where booking requests are delivered (defaults to booking@alnoorpalace.in)
HOTEL_BOOKING_EMAIL=

# Optional SMTP overrides (the API defaults to Gmail via GMAIL_USER / GMAIL_PASS)
# EMAIL_HOST=
# EMAIL_PORT=587
