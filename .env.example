# ---------------------------------------------------------------------------
# Booking engine (Supabase). Without these the site falls back to emailing
# booking REQUESTS instead of taking instant bookings.
# ---------------------------------------------------------------------------
# Supabase dashboard > Project Settings > API
# (also needed at BUILD time, so the site can show photos uploaded in the admin)
SUPABASE_URL=
# The SECRET service_role key. Server-only: never prefix it with NEXT_PUBLIC_
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Emails (booking confirmations to guests, notifications to the hotel)
# ---------------------------------------------------------------------------
# Gmail account that sends the emails. Use an app password, not the account password.
GMAIL_USER=
GMAIL_PASS=
# Where the hotel's notifications go (defaults to booking@alnoorpalace.in)
HOTEL_BOOKING_EMAIL=

# Optional SMTP overrides (defaults to Gmail via GMAIL_USER / GMAIL_PASS)
# EMAIL_HOST=
# EMAIL_PORT=587

# Optional: canonical site URL (defaults to https://alnoorpalace.in)
# NEXT_PUBLIC_SITE_URL=

# Optional advance payment by UPI (shown after booking; the booking itself is still pay-at-hotel).
# Defaults to the hotel group's UPI ID; set these only to change it.
# NEXT_PUBLIC_UPI_ID=7338944222@okbizaxis
# NEXT_PUBLIC_UPI_NAME=Al Noor Group of Hotels
